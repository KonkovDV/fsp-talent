# Скопируйте в .env. Демо-значения подходят для локального docker compose.

# Ключ подписи токенов. Для локального запуска можно оставить как есть: при первом старте контейнер
# создаст случайный ключ и сохранит его в томе vc_keys. На стенде задайте свой: openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=false
FSP_MODE=mock
AI_ENABLED=true
EMBEDDINGS_MODE=off
PUBLIC_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# Ключ авторизации GigaChat (developers.sber.ru). Пусто — разбор резюме только правилами.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Вторая модель для сверки ключа черновика. Пусто — черновики не запрашиваются и в тест не попадают.
GIGACHAT_CHECK_MODEL=
GIGACHAT_VERIFY_SSL=true
# YandexGPT (Yandex AI Studio) is used while GIGACHAT_CREDENTIALS is empty. The key belongs to a service account
# with the ai.languageModels.user role on the folder. Drafts need a second, different model.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1/latest
YANDEX_CHECK_MODEL=yandexgpt-5-lite/latest
# Pair model. Off until the weight folder exists (models/bge-reranker-v2-m3, not in git).
# In Docker the folder is mounted at /models. BM25 has no weight file.
CROSS_ENCODER_MODE=off
CROSS_ENCODER_MODEL=
# HttpOnly-cookie refresh. На локальном HTTP оставьте false.
COOKIE_SECURE=false

# Реестр ФСП. mock — тестовые протоколы; real — HTTP-клиент по контракту из docs/FSP_INTEGRATION.md
FSP_API_URL=
FSP_API_KEY=

# Вход через ФСП ID. mock — демо-страница на этом сайте (её проверяет смоук).
# oidc — Keycloak из docker-compose, realm fsp, клиент fsp-talent.
FSP_ID_MODE=mock
FSP_ID_ISSUER=http://localhost:8080/realms/fsp
FSP_ID_BACKEND_ISSUER=http://keycloak:8080/realms/fsp
FSP_ID_CLIENT_ID=fsp-talent
FSP_ID_CLIENT_SECRET=fsp-talent-demo
FSP_ID_CLAIM=fsp_id
