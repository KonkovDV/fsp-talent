# HTTPS without buying a domain: <ip-with-dashes>.sslip.io resolves to that IP, Caddy gets a Let's Encrypt
# certificate for it automatically. Set SITE_ADDRESS in deploy/.env, e.g. 203-0-113-10.sslip.io
# This file lives in a directory mount. A file mount keeps the old inode after git replaces it.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The API answers 413 when Content-Length is above 10 MB. The same bound here
	# stops a body that arrives without a length.
	@api path /api/* /health /docs /docs/* /openapi.json /.well-known/did.json
	handle @api {
		request_body {
			max_size 10MB
		}
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 120s
			}
		}
	}

	# These are not routes. The application page would answer 200 and look like a leaked file.
	@hidden path /.env /.env.* /.git /.git/**
	handle @hidden {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy frontend:80
	}
}
