# Copy to deploy/.env on the server. Never commit the real file.
SITE_ADDRESS=203-0-113-10.sslip.io          # your server IP with dashes + .sslip.io
SECRET_KEY=                                  # openssl rand -hex 32
POSTGRES_PASSWORD=                           # openssl rand -hex 16
FSP_MODE=mock
AI_ENABLED=false
EMBEDDINGS_MODE=off
# Letters with confirmation codes: any SMTP (Yandex 360, Mail.ru для бизнеса, Unisender Go, ...)
MAIL_MODE=smtp
MAIL_FROM=FSP Talent <no-reply@example.ru>
SMTP_HOST=smtp.example.ru
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
