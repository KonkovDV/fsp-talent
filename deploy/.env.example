# Copy to deploy/.env on the server. Never commit the real file.
SITE_ADDRESS=203-0-113-10.sslip.io          # your server IP with dashes + .sslip.io
ACME_EMAIL=                                  # optional; Let's Encrypt sends certificate expiry notices here
SECRET_KEY=                                  # openssl rand -hex 32
POSTGRES_PASSWORD=                           # openssl rand -hex 16
APP_DB_PASSWORD=                             # openssl rand -hex 32; the API logs in as fsp_app, not as the owner
SANDBOX_TOKEN=                               # openssl rand -hex 16; the API signs its calls to the code sandbox
FSP_MODE=mock
# mock is the built-in FSP ID page and is allowed only while DEMO_MODE=true. A real stand uses oidc.
FSP_ID_MODE=mock
DEMO_MODE=true
AI_ENABLED=false
# With AI_ENABLED=true: GigaChat (GIGACHAT_CREDENTIALS) or YandexGPT. The model only proposes quoted skills
# test drafts and an advisory card note; it never ranks or scores candidates. Names, emails and phones are cut before sending.
YANDEX_API_KEY=                              # service account key, role ai.languageModels.user
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1/latest
YANDEX_CHECK_MODEL=yandexgpt-5-lite/latest
EMBEDDINGS_MODE=off
# Local pair model. Off until both are set. Example: CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
# CROSS_ENCODER_DEVICE=auto|cpu|gpu
CROSS_ENCODER_MODE=off
CROSS_ENCODER_MODEL=
CROSS_ENCODER_DEVICE=auto
# Letters with confirmation codes: any SMTP (Yandex 360, Mail.ru для бизнеса, Unisender Go, ...)
MAIL_MODE=smtp
MAIL_FROM=FSP Talent <no-reply@example.ru>
SMTP_HOST=smtp.example.ru
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
# Jury trial and jury accounts jury1..jury10: true only on the stand for the jury, false for real people.
DEMO_MODE=false
# No SMTP account for the jury stand: with DEMO_MODE=true the code is shown on the confirmation screen
# to the person who registers (letters do not leave the server). Never true on a stand for real people.
DEMO_SHOW_CODE=false
